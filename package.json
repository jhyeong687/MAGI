  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx scripts/start.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/test-browser.ts",
    "doctor": "tsx scripts/doctor.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "tsx scripts/setup.ts",
    "login": "tsx scripts/login.ts",
    "screenshots": "tsx scripts/capture-showcase.ts",
    "social-preview": "tsx scripts/capture-social.ts"
  },
  "dependencies": {
    "@openai/codex": "0.165.0",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
